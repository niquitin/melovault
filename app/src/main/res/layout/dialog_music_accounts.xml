<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Pill handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_tertiary"
        android:layout_marginBottom="14dp" />

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/dialogAccountsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tài khoản nhạc"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/accountsRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="Làm mới"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_control"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <LinearLayout
        android:id="@+id/accountsLoadingView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang tải trạng thái tài khoản..."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Error View -->
    <LinearLayout
        android:id="@+id/accountsErrorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/accountsErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không kết nối được tới máy chủ"
            android:textSize="14sp"
            android:textColor="@color/status_offline"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/accountsRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="Thử lại"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_control"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Content List -->
    <ScrollView
        android:id="@+id/accountsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. APPLE MUSIC CARD -->
            <LinearLayout
                android:id="@+id/appleMusicCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Apple Music"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/appleStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/bg_quality_chip_inactive"
                        android:text="Chưa cấu hình"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/appleCapabilitiesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tính năng: Catalog Search, Thư viện cá nhân, Đọc danh sách phát"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/appleNoticeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cần cấu hình Apple MusicKit Developer Token trên máy chủ."
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/appleDisconnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Ngắt kết nối"
                        android:textSize="13sp"
                        android:textColor="@color/status_offline"
                        android:background="@drawable/bg_button_control"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/appleConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Kết nối"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_button_control"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. YOUTUBE CARD -->
            <LinearLayout
                android:id="@+id/youtubeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YouTube"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/youtubeStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/bg_quality_chip_inactive"
                        android:text="Chưa cấu hình"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/youtubeCapabilitiesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tính năng: Catalog Search, Đọc danh sách phát (Data API v3)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/youtubeNoticeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cần cấu hình Google OAuth Client ID trên máy chủ."
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/youtubePlaylistsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Xem danh sách phát"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_button_control"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/youtubeDisconnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Ngắt kết nối"
                        android:textSize="13sp"
                        android:textColor="@color/status_offline"
                        android:background="@drawable/bg_button_control"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/youtubeConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Kết nối"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_button_control"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Close Dialog Button -->
            <Button
                android:id="@+id/accountsCloseButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="Đóng"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_control"
                android:textAllCaps="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
