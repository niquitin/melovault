<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Pill handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_tertiary"
        android:layout_marginBottom="14dp" />

    <!-- Dialog Header -->
    <TextView
        android:id="@+id/dialogSignalPathTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signal Path"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- Error message view -->
    <TextView
        android:id="@+id/signalPathErrorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Không lấy được thông tin Signal Path"
        android:textSize="14sp"
        android:textColor="@color/status_offline"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <!-- Scrollable stages list -->
    <ScrollView
        android:id="@+id/signalPathScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/signalPathStagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. SOURCE STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stageSourceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/stageSourceDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 2. SERVER STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stageServerAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/stageServerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 3. DELIVERY STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DELIVERY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stageDeliveryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/stageDeliveryDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 4. NETWORK STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETWORK"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stageNetworkTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 5. PLAYER STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stagePlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Media3 / ExoPlayer"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 6. OUTPUT STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUTPUT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/stageOutputPipeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android system audio pipeline"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/stageOutputBitPerfect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bit-perfect: Not verified"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Clear Stream Cache button -->
    <TextView
        android:id="@+id/btnClearStreamCache"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_control"
        android:gravity="center"
        android:text="Xóa bộ nhớ đệm phát nhạc (Stream Cache)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
