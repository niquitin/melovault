<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Pill handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_tertiary"
        android:layout_marginBottom="14dp" />

    <!-- Track Header -->
    <TextView
        android:id="@+id/dialogTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/dialogTrackArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle"
        android:layout_marginBottom="8dp" />

    <!-- Action: Play Next -->
    <LinearLayout
        android:id="@+id/actionPlayNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary"
            android:contentDescription="Play Next icon" />

        <TextView
            android:id="@+id/actionPlayNextText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Phát tiếp theo"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Add to Queue -->
    <LinearLayout
        android:id="@+id/actionAddToQueue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_queue_music"
            android:tint="@color/text_primary"
            android:contentDescription="Add to Queue icon" />

        <TextView
            android:id="@+id/actionAddToQueueText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thêm vào hàng đợi"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Play From Here (shown only in collection contexts) -->
    <LinearLayout
        android:id="@+id/actionPlayFromHere"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/text_primary"
            android:contentDescription="Play from here icon" />

        <TextView
            android:id="@+id/actionPlayFromHereText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Phát từ bài này"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Favorite -->

    <LinearLayout
        android:id="@+id/actionFavorite"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/actionFavoriteIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/text_primary"
            android:contentDescription="Favorite icon" />

        <TextView
            android:id="@+id/actionFavoriteText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thêm vào Yêu thích"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Add to Playlist -->
    <LinearLayout
        android:id="@+id/actionAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_playlist"
            android:tint="@color/text_primary"
            android:contentDescription="Playlist icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thêm vào danh sách phát"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Open Artist -->
    <LinearLayout
        android:id="@+id/actionOpenArtist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_music_note"
            android:tint="@color/text_primary"
            android:contentDescription="Open Artist" />

        <TextView
            android:id="@+id/actionOpenArtistText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Mở nghệ sĩ"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Open Album -->
    <LinearLayout
        android:id="@+id/actionOpenAlbum"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_album_placeholder"
            android:tint="@color/text_primary"
            android:contentDescription="Open Album" />

        <TextView
            android:id="@+id/actionOpenAlbumText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Mở album"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Add Album to Playlist -->
    <LinearLayout
        android:id="@+id/actionAddAlbumToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_playlist"
            android:tint="@color/text_primary"
            android:contentDescription="Add Album" />

        <TextView
            android:id="@+id/actionAddAlbumToPlaylistText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thêm album vào danh sách phát"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Add Artist to Playlist -->
    <LinearLayout
        android:id="@+id/actionAddArtistToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_playlist"
            android:tint="@color/text_primary"
            android:contentDescription="Add Artist" />

        <TextView
            android:id="@+id/actionAddArtistToPlaylistText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thêm nghệ sĩ vào danh sách phát"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Multi Select -->
    <LinearLayout
        android:id="@+id/actionMultiSelect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_queue_music"
            android:tint="@color/text_primary"
            android:contentDescription="Multi Select" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Chọn nhiều bài"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Action: Remove from current playlist -->
    <LinearLayout
        android:id="@+id/actionRemoveFromPlaylist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_track_normal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:tint="@color/status_offline"
            android:contentDescription="Remove icon" />

        <TextView
            android:id="@+id/actionRemoveText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Xóa khỏi danh sách phát này"
            android:textSize="15sp"
            android:textColor="@color/status_offline" />
    </LinearLayout>

</LinearLayout>
