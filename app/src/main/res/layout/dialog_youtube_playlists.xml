<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Pill handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_tertiary"
        android:layout_marginBottom="14dp" />

    <!-- Container 1: Playlists List -->
    <LinearLayout
        android:id="@+id/ytPlaylistsListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách phát YouTube"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnYtPlaylistsClose"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="Đóng"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_control"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Loading View -->
        <LinearLayout
            android:id="@+id/ytPlaylistsLoadingView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tải danh sách phát..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Status / Empty / Error Text -->
        <TextView
            android:id="@+id/ytPlaylistsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Không tìm thấy danh sách phát"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- RecyclerView for Playlists -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ytPlaylistsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="380dp"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- Container 2: Playlist Items Details (Initially Gone) -->
    <LinearLayout
        android:id="@+id/ytPlaylistItemsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Subheader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnYtItemsBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="← Quay lại"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_control"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textAllCaps="false"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/txtYtItemsPlaylistTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chi tiết Playlist"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Items Loading View -->
        <LinearLayout
            android:id="@+id/ytItemsLoadingView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tải các bài hát..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Items Status / Empty Text -->
        <TextView
            android:id="@+id/ytItemsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Danh sách phát không có bài hát"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- RecyclerView for Playlist Items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ytPlaylistItemsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="380dp"
            android:overScrollMode="never" />
    </LinearLayout>

</LinearLayout>
