<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/footerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- Loading Container -->
    <LinearLayout
        android:id="@+id/footerLoadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/footerProgressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:id="@+id/footerLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Đang tải thêm…"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Error / Retry Container -->
    <LinearLayout
        android:id="@+id/footerErrorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/footerErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không tải được thêm"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/footerRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:minWidth="80dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_button_control"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Thử lại"
            android:textAllCaps="false"
            android:textColor="@color/accent_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
