<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trackRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_track_normal">

    <!-- Active Indicator Bar -->
    <View
        android:id="@+id/activeIndicator"
        android:layout_width="3.5dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_accent_indicator"
        android:visibility="gone"
        android:layout_marginEnd="6dp" />

    <!-- Multi-select Checkbox (Edit Mode) -->
    <CheckBox
        android:id="@+id/trackCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone"
        android:layout_marginEnd="6dp" />

    <!-- Track Artwork Thumbnail -->
    <ImageView
        android:id="@+id/trackThumbnail"
        android:layout_width="@dimen/track_thumbnail_size"
        android:layout_height="@dimen/track_thumbnail_size"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="Track cover" />

    <!-- Metadata: Title & Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/trackSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist Name"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/trackAudioInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1.5dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Track Duration -->
    <TextView
        android:id="@+id/trackDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        android:visibility="gone"
        android:text="00:00" />

    <!-- Now Playing Indicator (Play / Pause) -->
    <ImageView
        android:id="@+id/nowPlayingIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/accent_primary"
        android:visibility="gone"
        android:contentDescription="Currently playing" />

    <!-- Drag Handle (Edit Mode) -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/text_tertiary"
        android:visibility="gone"
        android:contentDescription="Kéo sắp xếp" />
</LinearLayout>
