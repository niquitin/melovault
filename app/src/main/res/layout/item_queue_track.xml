<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trackRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_track_normal">

    <!-- Active Indicator Bar -->
    <View
        android:id="@+id/activeIndicator"
        android:layout_width="3.5dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_accent_indicator"
        android:visibility="gone"
        android:layout_marginEnd="6dp" />

    <!-- Track Artwork Thumbnail -->
    <ImageView
        android:id="@+id/trackThumbnail"
        android:layout_width="@dimen/queue_thumbnail_size"
        android:layout_height="@dimen/queue_thumbnail_size"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="Track cover" />

    <!-- Metadata: Title & Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/trackSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist Name"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/trackAudioInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1.5dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Source / Offline Status Badge -->
    <TextView
        android:id="@+id/queueSourceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_button_tertiary"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- Current Playing Badge -->
    <TextView
        android:id="@+id/queueCurrentBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bài hiện tại"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_button_tertiary"
        android:textColor="@color/accent_primary"
        android:visibility="gone" />

    <!-- Now Playing Indicator (Play / Pause for current track) -->
    <ImageView
        android:id="@+id/nowPlayingIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="2dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/accent_primary"
        android:visibility="gone"
        android:contentDescription="Currently playing" />

    <!-- Drag Handle (For upcoming tracks) -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/text_tertiary"
        android:visibility="gone"
        android:contentDescription="Kéo sắp xếp" />

    <!-- Remove Button (For any queue item) -->
    <ImageView
        android:id="@+id/removeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:tint="@color/text_tertiary"
        android:visibility="visible"
        android:contentDescription="Xóa khỏi hàng đợi" />

</LinearLayout>
