<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicAssistantCar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_variant</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:popupBackground">@color/bg_surface_elevated</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.MusicAssistantCar.Splash" parent="Theme.MusicAssistantCar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
    </style>

    <style name="Theme.MusicAssistantCar.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/bg_surface_elevated</item>
        <item name="colorSurface">@color/bg_surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorAccent">@color/accent_primary</item>
    </style>
</resources>
